# Copy this file to .env and fill in the values you have.
# NEVER commit .env or share secret keys.

PORT=3001
FRONTEND_ORIGIN=http://localhost:8000

# ---- Paystack (https://dashboard.paystack.com) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Flutterwave (https://dashboard.flutterwave.com) ----
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_HASH_SECRET=

# ---- Stripe (https://dashboard.stripe.com) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- PayPal (https://developer.paypal.com) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
# PayPal does not accept NGN. 1 USD in naira (check the current rate).
NGN_TO_USD_RATE=1500

# ---- CJ Dropshipping (https://app.cjdropshipping.com -> API page) ----
# The key is exchanged for an access token; it is never sent to the browser.
CJ_API_KEY=
CJ_API_BASE=https://developers.cjdropshipping.com
CJ_ORDER_ENDPOINT=/api2.0/v1/shopping/order/createOrderV3
CJ_ORDER_STATUS_ENDPOINT=/api2.0/v1/shopping/order/getOrderDetail
# From CJ freight-calculate for CN -> NG. Verified working: "CJPacket Postal".
CJ_LOGISTIC_NAME=CJPacket Postal
# 3 = create order only, then pay in your CJ dashboard (CJ balance is $0 by default).
# 2 = pay from CJ balance at creation (only after you fund the balance).
CJ_PAY_TYPE=3
# 1 = sandbox order (no real charge or fulfilment), 0 = live. Keep 1 while testing.
CJ_SANDBOX=1
CJ_FROM_COUNTRY_CODE=CN
# Empty is valid unless CJ issued you a platform token.
CJ_PLATFORM_TOKEN=

# ---- Money maths ----
# 1 Chinese yuan in naira. Check the rate before you price products.
EXCHANGE_RATE_CNY_TO_NGN=240

# ---- Bank transfer display (optional) ----
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
